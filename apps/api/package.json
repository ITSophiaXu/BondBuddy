{
  "name": "@bondbuddy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "default": "./dist/queue.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "default": "./dist/observability.js"
    },
    "./provider-results": {
      "types": "./dist/provider-results.d.ts",
      "default": "./dist/provider-results.js"
    },
    "./ocr": {
      "types": "./dist/ocr.d.ts",
      "default": "./dist/ocr.js"
    },
    "./material-jobs": {
      "types": "./dist/material-jobs.d.ts",
      "default": "./dist/material-jobs.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --test --test-concurrency=1 dist/*.test.js",
    "storage:lifecycle": "node dist/storage-lifecycle.js"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@bondbuddy/contracts": "0.1.0",
    "@sinclair/typebox": "^0.34.41",
    "argon2": "^0.44.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.6.1",
    "file-type": "^22.1.1",
    "jpeg-js": "^0.4.4",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/yazl": "^3.3.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "yazl": "^3.3.1"
  }
}
