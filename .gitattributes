# Official evidence is hashed as downloaded. Never normalize its line endings.
# Runtime candidates are pinned to these LF repository bytes on every build host.
/knowledge/exchange-bonds/drafts/sse-private/rule-pack.json text eol=lf
/knowledge/exchange-bonds/drafts/sse-private/chapter-template.json text eol=lf
/knowledge/exchange-bonds/drafts/sse-private/coverage.json text eol=lf
# The authorised batch and its exact generated projection are also byte-pinned.
/tests/samples/2026-09-25/manifest.json text eol=lf
/apps/worker/src/authorized-sample-membership.generated.ts text eol=lf
/knowledge/exchange-bonds/verification/*/notices/*.html binary
/knowledge/exchange-bonds/verification/*/originals/* binary
# Generated views remain readable, while the curated scripts/catalog lead PR review.
/knowledge/exchange-bonds/verification/*/sources/*.md linguist-generated=true
/knowledge/exchange-bonds/records/OV-*.json linguist-generated=true
/knowledge/exchange-bonds/originals/* binary
/knowledge/exchange-bonds/intake/*/*.html binary
