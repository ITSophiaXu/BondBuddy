  "extraction_status": "ooxml_text_extracted",
  "records": [
    {
      "locator": "P00001",
      "role": "body",
      "text": "附件2："
    },
    {
      "locator": "P00002",
      "role": "body",
      "text": "行业表格：股权投资行业信息披露表（试行）"
    },
    {
      "locator": "P00003",
      "role": "body",
      "text": "披露文件"
    },
    {
      "locator": "P00004",
      "role": "body",
      "text": "信息披露要点"
    },
    {
      "locator": "P00005",
      "role": "body",
      "text": "募集说明书"
    },
    {
      "locator": "P00006",
      "role": "body",
      "text": "——"
    },
    {
      "locator": "P00007",
      "role": "body",
      "text": "企业基本情况"
    },
    {
      "locator": "P00008",
      "role": "body",
      "text": "章节"
    },
    {
      "locator": "P00009",
      "role": "body",
      "text": "披露股权投资业务模式，包括但不限于运营方式、投资资金来源、投资决策流程、风险控制策略、投资项目遴选标准、业务合法合规性等。"
    },
    {
      "locator": "P00011",
      "role": "body",
      "text": "发行人应突出股权投资机构行业特征，其中："
    },
    {
      "locator": "P00012",
      "role": "body",
      "text": "1.发行人及其子公司存在基金投资业务的，披露如下："
    },
    {
      "locator": "P00013",
      "role": "body",
      "text": "①管理人资质情况，披露管理人名称、获得资质时间等；"
    },
    {
      "locator": "P00014",
      "role": "body",
      "text": "②基金管理情况，包括但不限于管理基金的数量、总规模、投资方向、退出情况等，列表披露主要在管基金的名称、类型、存续期、认缴与实缴规模、已投项目数量、退出项目数量等；"
    },
    {
      "locator": "P00015",
      "role": "body",
      "text": "③参投基金情况，包括但不限于已参投基金的数量、参投金额等，列表披露参投基金的名称、类型、存续期、投资方向、参投份额及其对应的认缴与实缴规模等；"
    },
    {
      "locator": "P00016",
      "role": "body",
      "text": "④报告期内基金清盘情况，包括但不限于清盘规模、收益水平等，列表披露清盘基金名称、发行人累计投资规模、退出规模、收益水平指标等；"
    },
    {
      "locator": "P00017",
      "role": "body",
      "text": "⑤超期仍未退出的基金情况（如有），包括但不限于基金规模、未按时退出原因、后续延期安排等。"
    },
    {
      "locator": "P00018",
      "role": "body",
      "text": "2、发行人及其子公司存在股权投资业务的，披露如下："
    },
    {
      "locator": "P00019",
      "role": "body",
      "text": "①已投项目情况，包括但不限于已投项目的数量、投资金额、投资方向等，列表披露已投资项目的名称、金额、行业、投资时间、持股比例等；②报告期内已投资项目退出情况，包括但不限于退出项目的规模、退出方式、收益水平指标等。"
    },
    {
      "locator": "P00020",
      "role": "body",
      "text": "募集说明书"
    },
    {
      "locator": "P00021",
      "role": "body",
      "text": "——"
    },
    {
      "locator": "P00022",
      "role": "body",
      "text": "企业主要"
    },
    {
      "locator": "P00023",
      "role": "body",
      "text": "财务状况"
    },
    {
      "locator": "P00024",
      "role": "body",
      "text": "章节"
    },
    {
      "locator": "P00025",
      "role": "body",
      "text": "重点披露交易性金融资产、长期股权投资、其他非流动金融资产的具体构成及变化情况，其中相关资产科目涉及投资业务所投企业、基金的，需披露发行人对其份额明细及持股比例情况。"
    }
  ]
}
