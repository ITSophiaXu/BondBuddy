{
  "source_id": "NA063",
  "original_sha256": "6ecd9c92adf428d1702e96fe9653ff7f35c7d6c86bdaf61764efb9e40bc1c713",
  "extraction_status": "ooxml_text_extracted",
  "records": [
    {
      "locator": "P00001",
      "role": "body",
      "text": "附件1："
    },
    {
      "locator": "P00002",
      "role": "body",
      "text": "科技型企业科技创新债券信息披露表（试行）"
    },
    {
      "locator": "P00003",
      "role": "body",
      "text": "披露文件"
    },
    {
      "locator": "P00004",
      "role": "body",
      "text": "信息披露要点"
    },
    {
      "locator": "P00005",
      "role": "body",
      "text": "募集说明书"
    },
    {
      "locator": "P00006",
      "role": "body",
      "text": "——"
    },
    {
      "locator": "P00007",
      "role": "body",
      "text": "重要提示章节"
    },
    {
      "locator": "P00008",
      "role": "body",
      "text": "简要披露说明发行人所属科技创新债券主体类别和对应情形。"
    },
    {
      "locator": "P00010",
      "role": "body",
      "text": "根据保密性等要求，企业可按需简化经营模式、供应链上下游、核心科技优势、重要在研项目等相关信息披露。需说明豁免相关内容的必要性，并承诺相关内容不会对本期债券产生不利影响。"
    },
    {
      "locator": "P00011",
      "role": "body",
      "text": "募集说明书"
    },
    {
      "locator": "P00012",
      "role": "body",
      "text": "——"
    },
    {
      "locator": "P00013",
      "role": "body",
      "text": "募集资金"
    },
    {
      "locator": "P00014",
      "role": "body",
      "text": "运用章节"
    },
    {
      "locator": "P00015",
      "role": "body",
      "text": "注册阶段："
    },
    {
      "locator": "P00016",
      "role": "body",
      "text": "匡算募集资金用途大类，无需披露具体明细，但需合理匡算注册规模。"
    },
    {
      "locator": "P00018",
      "role": "body",
      "text": "发行阶段："
    },
    {
      "locator": "P00019",
      "role": "body",
      "text": "1.对于成熟层企业（即第一类TDFI、第二类DFI企业），可按注册阶段要求披露募集资金用途。"
    },
    {
      "locator": "P00020",
      "role": "body",
      "text": "2.对于成熟层以外的企业，应具体披露募集资金用途。"
    },
    {
      "locator": "P00022",
      "role": "body",
      "text": "披露科技型企业符合科技创新债券具体对应的情形，具体如下："
    },
    {
      "locator": "P00023",
      "role": "body",
      "text": "情形1，应披露企业具备科技创新称号的相关情况，包括但不限于称号名称、认定机构、政策依据以及有效期等；"
    },
    {
      "locator": "P00024",
      "role": "body",
      "text": "情形2，应披露企业所入选名单情况或科技贷款支持范围的具体类别，包括但不限于有关筛选标准、企业符合标准的相关说明等；"
    },
    {
      "locator": "P00025",
      "role": "body",
      "text": "情形3，应披露企业所属上市板块、所属行业领域等；"
    },
    {
      "locator": "P00026",
      "role": "body",
      "text": "情形4，应披露专利所属领域、专利能否用于产业化、专利与主营业务相关性等；"
    },
    {
      "locator": "P00027",
      "role": "body",
      "text": "情形5，应披露有关部门认定属于科技型企业的相关依据。"
    },
    {
      "locator": "P00028",
      "role": "body",
      "text": "母公司发行科技创新债券支持科技型子公司发展的，根据对应情形披露子公司相关信息。"
    },
    {
      "locator": "P00029",
      "role": "body",
      "text": "募集说明书"
    },
    {
      "locator": "P00030",
      "role": "body",
      "text": "——"
    },
    {
      "locator": "P00031",
      "role": "body",
      "text": "持有人会议"
    },
    {
      "locator": "P00032",
      "role": "body",
      "text": "机制章节"
    },
    {
      "locator": "P00033",
      "role": "body",
      "text": "企业擅自或违规发行科技创新债券的，应提请召开持有人会议向投资人进行解释说明，保护投资人的合法权益。"
    },
    {
      "locator": "P00034",
      "role": "body",
      "text": "募集说明书"
    },
    {
      "locator": "P00035",
      "role": "body",
      "text": "——"
    },
    {
      "locator": "P00036",
      "role": "body",
      "text": "信息披露安排章节"
    },
    {
      "locator": "P00037",
      "role": "body",
      "text": "如果存续期企业不再符合主体范围认定标准的，企业应进行专项披露。专项披露文件应就原因、具体情况及可能影响进行说明。"
    },
    {
      "locator": "P00038",
      "role": "body",
      "text": "企业擅自或违规发行科技创新债券的应在存续期进行更正披露，就原因、具体情况及可能影响进行说明。"
    },
    {
      "locator": "P00039",
      "role": "body",
      "text": "法律意见书"
    },
    {
      "locator": "P00040",
      "role": "body",
      "text": "律师需就企业是否符合科技创新债券支持情形发表明确意见。"
    },
    {
      "locator": "P00042",
      "role": "body",
      "text": "股权投资机构科技创新债券信息披露表（试行）"
    },
    {
      "locator": "P00043",
      "role": "body",
      "text": "披露文件"
    },
    {
      "locator": "P00044",
      "role": "body",
      "text": "信息披露要点"
    },
    {
      "locator": "P00045",
      "role": "body",
      "text": "募集说明书"
    },
    {
      "locator": "P00046",
      "role": "body",
      "text": "——"
    },
    {
      "locator": "P00047",
      "role": "body",
      "text": "重要提示章节"
    },
    {
      "locator": "P00048",
      "role": "body",
      "text": "简要披露说明发行人所属科技创新债券主体类别和对应情形。"
    },
    {
      "locator": "P00050",
      "role": "body",
      "text": "根据投资标的保密性等需求，可简化投资项目遴选标准、投资资金来源、在管基金情况、参投基金情况、股权投资业务已投项目情况等相关信息披露。需说明豁免相关内容的必要性，并承诺相关内容不会对本期债券产生不利影响。"
    },
    {
      "locator": "P00051",
      "role": "body",
      "text": "募集说明书"
    },
    {
      "locator": "P00052",
      "role": "body",
      "text": "——"
    },
    {
      "locator": "P00053",
      "role": "body",
      "text": "募集资金"
    },
    {
      "locator": "P00054",
      "role": "body",
      "text": "运用章节"
    },
    {
      "locator": "P00055",
      "role": "body",
      "text": "注册阶段：用于科技创新领域的，应披露拟投资项目投资领域、遴选标准及流程，科技创新领域包括科技型企业和高技术制造业、高技术服务业、战略性新兴产业、知识产权（专利）密集型产业等科技相关产业。"
    },
    {
      "locator": "P00057",
      "role": "body",
      "text": "发行阶段："
    },
    {
      "locator": "P00058",
      "role": "body",
      "text": "1.对于成熟层企业（即第一类TDFI、第二类DFI企业），暂无投资标的具体信息的，按注册阶段要求披露项目投资领域、遴选标准及流程、是否符合科技创新相关要求等内容。"
    },
    {
      "locator": "P00059",
      "role": "body",
      "text": "2.对于成熟层以外的企业，发行阶段应披露科技创新的具体用途，可列示高于实际发行规模的科技创新用途。"
    },
    {
      "locator": "P00060",
      "role": "body",
      "text": "①用于科创领域股权投资的，披露募集资金匡算依据、发行人与拟投资企业之间的持股关系及变动情况、拟投资金额、拟使用募集资金占投资额比例、股权投资运营实体情况、投资方式、被投企业科技创新属性等；"
    },
    {
      "locator": "P00061",
      "role": "body",
      "text": "②用于科技创新领域基金出资的，披露基金类型及相关认定情况、基金备案情况、各方认缴金额及出资比例、资金到位情况、基金投向、已投项目情况、基金存续期等。"
    },
    {
      "locator": "P00063",
      "role": "body",
      "text": "披露股权投资机构符合科技创新债券具体对应的情形，具体如下："
    },
    {
      "locator": "P00064",
      "role": "body",
      "text": "情形1，应披露发行人相关基金管理人资质及牌照情况；"
    },
    {
      "locator": "P00065",
      "role": "body",
      "text": "情形2，应披露发行人近两年投资产生的相关收入在整体营业收入的占比情况、企业或主要负责投资的团队成立时长，并以列表形式列明近三年重要成功项目退出案例；"
    },
    {
      "locator": "P00066",
      "role": "body",
      "text": "情形3，应披露发行人符合《国务院关于推进国有资本投资、运营公司改革试点的实施意见》（国发〔2018〕23号）相关情况，包括但不限于总体要求、功能定位、授权机制、治理结构等，并进行对应承诺；"
    },
    {
      "locator": "P00067",
      "role": "body",
      "text": "情形4，应披露发行人符合相关要求的依据。"
    },
    {
      "locator": "P00069",
      "role": "body",
      "text": "企业发行科技创新债券，应对募集资金用途及使用方式的合规性、存续期变更募集资金用途等事项进行承诺。"
    },
    {
      "locator": "P00070",
      "role": "body",
      "text": "募集说明书"
    },
    {
      "locator": "P00071",
      "role": "body",
      "text": "——"
    },
    {
      "locator": "P00072",
      "role": "body",
      "text": "信息披露安排章节"
    },
    {
      "locator": "P00073",
      "role": "body",
      "text": "债券存续期内每年4月30日、8月31日前披露存续期间募集资金具体使用情况，披露内容包括但不限于已投项目数量及情况、所投项目或公司符合科技创新属性说明、基金类型、未使用募集资金规模、募集资金管理等情况。"
    },
    {
      "locator": "P00074",
      "role": "body",
      "text": "法律意见书"
    },
    {
      "locator": "P00075",
      "role": "body",
      "text": "法律意见书需对业务合法合规性发表意见，明确发行人募集资金使用不违反有关法律法规及规范性文件要求。"
    }
  ]
}
