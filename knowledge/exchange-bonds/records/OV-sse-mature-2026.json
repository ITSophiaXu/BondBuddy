  "notice_sha256": "4a0b752c22d860f5c12760dd5f982ba2c60a5cd291c74e2e44ad9cc616ffe883",
  "parse_status": "extracted",
  "extraction": "Official XML paragraphs / PDF physical pages; NOTICE is archived announcement text. No layout/OCR acceptance.",
  "records": [
    {
      "locator": "P00001",
      "text": "附件",
      "role": "body"
    },
    {
      "locator": "P00003",
      "text": "上海证券交易所公司债券发行上市审核",
      "role": "body"
    },
    {
      "locator": "P00004",
      "text": "规则适用指引第6号——知名成熟",
      "role": "body"
    },
    {
      "locator": "P00005",
      "text": "发行人优化审核",
      "role": "body"
    },
    {
      "locator": "P00006",
      "text": "（2026年修订）",
      "role": "body"
    },
    {
      "locator": "P00008",
      "text": "第一章 总则",
      "role": "body"
    },
    {
      "locator": "P00009",
      "text": "第一条 为了规范公司债券（含企业债券）审核实施程序，提升知名成熟发行人债券融资效率，上海证券交易所（以下简称本所）根据《公司债券发行与交易管理办法》《上海证券交易所公司债券发行上市审核规则》《上海证券交易所非公开发行公司债券挂牌规则》等规定，制定本指引。",
      "role": "body"
    },
    {
      "locator": "P00010",
      "text": "第二条 本所按照分类监管理念，对知名成熟发行人的公司债券申请项目适用优化审核安排，简化审核流程、提高融资服务效率。",
      "role": "body"
    },
    {
      "locator": "P00011",
      "text": "本指引所称知名成熟发行人，指市场认可度高、行业地位显著、公司治理完善、经营财务状况稳健、信息披露成熟的发行人。",
      "role": "body"
    },
    {
      "locator": "P00012",
      "text": "本所可以根据市场发展情况与审核工作开展情况，适时调整优化审核安排并向市场公开。",
      "role": "body"
    },
    {
      "locator": "P00013",
      "text": "第三条 主承销商、证券服务机构应当积极协助发行人评估并申请适用本指引规定的优化审核安排。",
      "role": "body"
    },
    {
      "locator": "P00014",
      "text": "第二章优化审核认定",
      "role": "body"
    },
    {
      "locator": "P00015",
      "text": "第四条 同时符合下列情形的发行人，本所可以对其公司债券申请项目适用优化审核安排：",
      "role": "body"
    },
    {
      "locator": "P00016",
      "text": "（一）公司生产经营符合国家宏观调控政策和产业政策，市场认可度高、行业地位显著、公司治理完善、信息披露成熟；",
      "role": "body"
    },
    {
      "locator": "P00017",
      "text": "（二）经营财务状况稳健，企业规模、资本结构、盈利能力满足相应要求（具体要求详见附件1）；",
      "role": "body"
    },
    {
      "locator": "P00018",
      "text": "（三）最近3年财务报告未被注册会计师出具非无保留意见的审计报告，或者最近3年内财务报表曾被注册会计师出具保留意见但保留意见所涉及事项的重大影响已经消除；",
      "role": "body"
    },
    {
      "locator": "P00019",
      "text": "（四）最近36个月内公司及其所属企业集团、实际控制人无债券或者其他债务违约、延迟支付本息的情形；",
      "role": "body"
    },
    {
      "locator": "P00020",
      "text": "（五）公司未受到债券融资限制，且最近36个月内公司未因债券业务违规被实施行政处罚或纪律处分；",
      "role": "body"
    },
    {
      "locator": "P00021",
      "text": "（六）本所根据投资者保护需要确定的其他标准。",
      "role": "body"
    },
    {
      "locator": "P00022",
      "text": "鼓励符合条件的民营企业向本所提出适用优化审核安排。",
      "role": "body"
    },
    {
      "locator": "P00023",
      "text": "第五条 发行人不符合第四条第一款第二项规定，但符合下列情形之一的，本所也可以对其公司债券申请项目适用优化审核安排：",
      "role": "body"
    },
    {
      "locator": "P00024",
      "text": "（一）上市公司最近两年信息披露工作评价结果为A，且资产总额不低于200亿元、净资产收益率不低于2%；",
      "role": "body"
    },
    {
      "locator": "P00025",
      "text": "（二）在全球市场或者在国家重点支持的行业领域等具有领先地位；",
      "role": "body"
    },
    {
      "locator": "P00026",
      "text": "（三）本所根据国家政策导向和市场发展需要认可的其他情形。",
      "role": "body"
    },
    {
      "locator": "P00027",
      "text": "前款所称资产总额、净资产收益率，按照企业最近一年经审计的财务数据或者最近3年经审计的财务数据平均值孰优者确定。净资产收益率按照《公开发行证券的公司信息披露编报规则第9号——净资产收益率和每股收益的计算及披露》规定公式计算。",
      "role": "body"
    },
    {
      "locator": "P00028",
      "text": "第六条 发行人符合第四条、第五条规定的，可以书面形式（参考格式详见附件2）向本所说明公司符合优化审核认定标准。",
      "role": "body"
    },
    {
      "locator": "P00029",
      "text": "本所经确认，向发行人出具适用优化审核安排的函，自出具之日起36个月内，发行人向本所申报的公司债券项目可以适用本指引第三章规定的优化审核安排。",
      "role": "body"
    },
    {
      "locator": "P00030",
      "text": "优化审核安排到期后，发行人仍然符合认定标准的，经履行本条第二款规定的程序，可以继续适用相关安排。",
      "role": "body"
    },
    {
      "locator": "P00031",
      "text": "第七条 发行人出现下列情形，可能严重影响发行人偿债能力的，本所可以终止对发行人公司债券项目适用优化审核安排：",
      "role": "body"
    },
    {
      "locator": "P00032",
      "text": "（一）不符合本指引第四条、第五条规定的情形；",
      "role": "body"
    },
    {
      "locator": "P00033",
      "text": "（二）相关财务指标出现重大不利变化；",
      "role": "body"
    },
    {
      "locator": "P00034",
      "text": "（三）融资过度且出现债务集中兑付压力；",
      "role": "body"
    },
    {
      "locator": "P00035",
      "text": "（四）行业地位发生重大不利变化；",
      "role": "body"
    },
    {
      "locator": "P00036",
      "text": "（五）债券、股票成交持续异常波动；",
      "role": "body"
    },
    {
      "locator": "P00037",
      "text": "（六）公司及其所属企业集团、实际控制人出现重大负面舆情。",
      "role": "body"
    },
    {
      "locator": "P00038",
      "text": "发行人、主承销商应当将所涉前款情形及时报告本所，说明相关情况。前款规定情形消除后，发行人可以重新按本指引第六条规定的方式向本所提出适用优化审核安排。",
      "role": "body"
    },
    {
      "locator": "P00039",
      "text": "第三章优化审核的措施",
      "role": "body"
    },
    {
      "locator": "P00040",
      "text": "第八条 知名成熟发行人可以按照下列方式编制、提交申请文件：",
      "role": "body"
    },
    {
      "locator": "P00041",
      "text": "（一）一般公司债券、企业债券和专项品种公司债券可以合并编制申请文件并统一申报。申报的公司债券发行规模等应当符合公司债券的法定发行条件，申报阶段无需明确募集资金具体使用安排。",
      "role": "body"
    },
    {
      "locator": "P00042",
      "text": "（二）发行人可以在发行前备案阶段再明确每期发行的具体品种、发行方案、募集资金运用安排、债项评级（如有）等；企业债券可使用不超过50%的募集资金用于补充流动资金等非项目建设用途。",
      "role": "body"
    },
    {
      "locator": "P00043",
      "text": "（三）发行人可以按照本所简明信息披露相关规定，通过列表、索引等形式简化申报发行材料和信息披露，在保证信息披露质量的前提下，提高信息披露的针对性和有效性。",
      "role": "body"
    },
    {
      "locator": "P00044",
      "text": "（四）不存在影响公司经营或偿债能力的重大不利变化，且不存在影响发行上市条件的重大事项的，发行人可以申请适当延长年度、半年度财务报告有效期。年度财务报告有效期最多延长至当年8月末，半年度财务报告有效期最多延长至次年4月末。已披露季度财务报告的，应当同步披露主要季度财务数据。",
      "role": "body"
    },
    {
      "locator": "P00045",
      "text": "首次申请公开发行公司债券的发行人不适用本项优化审核安排。",
      "role": "body"
    },
    {
      "locator": "P00046",
      "text": "（五）公司董事、监事（如有）、高级管理人员在债券项目申请和发行阶段按照规定对债券发行文件签署书面确认意见，并承诺认可各期发行文件、履行规定职责的，每期债券发行前无需另行签署书面确认意见。发行阶段董事、监事（如有）、高级管理人员较前次签署确认意见时发生变化的，新任人员应当签署书面确认意见。",
      "role": "body"
    },
    {
      "locator": "P00047",
      "text": "（六）审计机构已对发行人前期募集说明书中引用的审计报告内容出具过声明页，确认募集说明书与审计报告一致，并经主承销商核查本期债券发行文件引用的审计报告内容与前期一致的，每期债券发行前审计机构无需再次签署相关声明。",
      "role": "body"
    },
    {
      "locator": "P00048",
      "text": "第九条 知名成熟发行人可以在项目申报时确认设立主承销商团，待各期债券发行时指定主承销商。",
      "role": "body"
    },
    {
      "locator": "P00049",
      "text": "第十条 本所对知名成熟发行人债券项目申请，审核时限原则上不超过10个工作日。",
      "role": "body"
    },
    {
      "locator": "P00050",
      "text": "第十一条 知名成熟发行人可以在前次公司债券有效注册文件或挂牌转让无异议函到期前6个月内向本所再次申请发行公司债券。披露信息无重大变化的，发行人可以适当简化编制申请文件。",
      "role": "body"
    },
    {
      "locator": "P00051",
      "text": "第四章附则",
      "role": "body"
    },
    {
      "locator": "P00052",
      "text": "第十二条 本所对企业债券、专项品种公司债券、特定行业发行人债券项目的审核程序另有规定的，从其规定。",
      "role": "body"
    },
    {
      "locator": "P00053",
      "text": "第十三条 本指引由本所负责解释。",
      "role": "body"
    },
    {
      "locator": "P00054",
      "text": "第十四条 本指引自发布之日起施行。本所于2023年10月20日发布的《上海证券交易所公司债券发行上市审核规则适用指引第6号——知名成熟发行人优化审核》（上证发〔2023〕172号）同时废止。",
      "role": "body"
    },
    {
      "locator": "P00056",
      "text": "附件：1.发行人分行业经营财务指标要求",
      "role": "body"
    },
    {
      "locator": "P00057",
      "text": "2.××公司关于确认适用优化审核安排的说明（样张）",
      "role": "body"
    },
    {
      "locator": "P00061",
      "text": "附件1",
      "role": "body"
    },
    {
      "locator": "P00063",
      "text": "发行人分行业经营财务指标要求",
      "role": "body"
    },
    {
      "locator": "P00065",
      "text": "一、发行人对其公司债券申请项目适用优化审核安排的，其企业规模、资本结构、盈利能力应按照行业类别同时满足以下要求：",
      "role": "body"
    },
    {
      "locator": "P00066",
      "text": "单位：亿元、%",
      "role": "body"
    },
    {
      "locator": "P00067",
      "text": "行业分类",
      "role": "body"
    },
    {
      "locator": "P00068",
      "text": "资产",
      "role": "body"
    },
    {
      "locator": "P00069",
      "text": "总额",
      "role": "body"
    },
    {
      "locator": "P00070",
      "text": "资产",
      "role": "body"
    },
    {
      "locator": "P00071",
      "text": "负债率",
      "role": "body"
    },
    {
      "locator": "P00072",
      "text": "总资产报酬率",
      "role": "body"
    },
    {
      "locator": "P00073",
      "text": "批发和零售业，居民服务、修理和其他服务业，租赁和商务服务业，住宿和餐饮业、农林牧渔业，教育，卫生和社会工作，文化、体育和娱乐业",
      "role": "body"
    },
    {
      "locator": "P00074",
      "text": "＞800",
      "role": "body"
    },
    {
      "locator": "P00075",
      "text": "＜75",
      "role": "body"
    },
    {
      "locator": "P00076",
      "text": "＞2.5",
      "role": "body"
    },
    {
      "locator": "P00077",
      "text": "电力、热力、燃气及水生产和供应业，交通运输、仓储和邮政业，信息传输、软件和信息技术服务业",
      "role": "body"
    },
    {
      "locator": "P00078",
      "text": "＞1,000",
      "role": "body"
    },
    {
      "locator": "P00079",
      "text": "＜85",
      "role": "body"
    },
    {
      "locator": "P00080",
      "text": "＞2.5",
      "role": "body"
    },
    {
      "locator": "P00081",
      "text": "建筑业，水利、环境和公共设施管理业，综合",
      "role": "body"
    },
    {
      "locator": "P00082",
      "text": "＞1,200",
      "role": "body"
    },
    {
      "locator": "P00083",
      "text": "＜85",
      "role": "body"
    },
    {
      "locator": "P00084",
      "text": "＞2.5",
      "role": "body"
    },
    {
      "locator": "P00085",
      "text": "制造业，采矿业，科学研究和技术服务业",
      "role": "body"
    },
    {
      "locator": "P00086",
      "text": "＞1,000",
      "role": "body"
    },
    {
      "locator": "P00087",
      "text": "＜80",
      "role": "body"
    },
    {
      "locator": "P00088",
      "text": "＞2.5",
      "role": "body"
    },
    {
      "locator": "P00089",
      "text": "发行人符合下列条件之一的，经本所审慎确认后，资产负债率或总资产报酬率其一符合上表中分行业经营财务指标要求即可，但总资产报酬率应不低于1.5%：",
      "role": "body"
    },
    {
      "locator": "P00090",
      "text": "（一）资产总额不少于2,500亿元；",
      "role": "body"
    },
    {
      "locator": "P00091",
      "text": "（二）由中国证监会派出机构或省级政府主管部门推荐并经本所认可，且资产总额满足分行业经营财务指标要求的企业。",
      "role": "body"
    },
    {
      "locator": "P00092",
      "text": "二、发行人应当参照《中国上市公司协会上市公司行业统计分类指引》确认行业归属。",
      "role": "body"
    },
    {
      "locator": "P00093",
      "text": "三、资产总额、资产负债率、总资产报酬率应当按照企业最近一年经审计的财务数据进行计算，或者按照最近3年经审计的财务数据分别进行计算后取平均值，两者按孰优原则选择。其中，总资产报酬率（%）=EBIT（息税前盈余）/总资产平均余额×100%；EBIT（息税前盈余）=利润总额+费用化利息支出。",
      "role": "body"
    },
    {
      "locator": "P00094",
      "text": "四、本所可以根据市场发展及投资者保护需要，适时调整适用优化审核安排的发行人分行业经营财务指标要求。",
      "role": "body"
    },
    {
      "locator": "P00095",
      "text": "附件2",
      "role": "body"
    },
    {
      "locator": "P00097",
      "text": "××公司关于确认适用优化审核安排的说明",
      "role": "body"
    },
    {
      "locator": "P00098",
      "text": "（样张）",
      "role": "body"
    },
    {
      "locator": "P00100",
      "text": "上海证券交易所：",
      "role": "body"
    },
    {
      "locator": "P00101",
      "text": "根据《上海证券交易所公司债券发行上市审核规则适用指引第6号——知名成熟发行人优化审核》规定，我公司符合上海证券交易所公司债券优化审核安排的适用条件，现来函说明。",
      "role": "body"
    },
    {
      "locator": "P00102",
      "text": "一、公司基本情况",
      "role": "body"
    },
    {
      "locator": "P00103",
      "text": "中文名称",
      "role": "body"
    },
    {
