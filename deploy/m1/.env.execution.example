# Start with the existing private runtime env, preserve all business/provider/auth values.
# Merge these role-specific entries. Never commit the resulting private file.
BB_DEPLOY_ROLE=execution
COMPOSE_PROJECT_NAME=bb-execution
BB_HTTP_PORT=18080
BB_PUBLIC_ORIGIN=https://bondbuddy.example
BB_TERMS_VERSION=existing-terms-version
BB_TRIAL_SOURCE_SALT=replace-with-existing-value
BB_PARSE_CACHE_OCR_VERSION=existing-ocr-version
BB_PARSE_CACHE_BASIS_VERSION=existing-basis-version
AZURE_STORAGE_CONNECTION_STRING=replace-with-existing-private-blob-connection
# URL-encode the existing database password; this is the sole business PG on the main site.
BB_EXECUTION_DATABASE_URL=postgresql://bondbuddy:replace-url-encoded-password@pg-tunnel:5432/bondbuddy
# Execution-only cross-cloud PG lease, in seconds; runtime accepts integers from 5 to 600.
BB_WORKER_LEASE_SECONDS=120
BB_PG_SSH_HOST=database-ssh.example
BB_PG_SSH_PORT=22
BB_PG_SSH_USER=bb-pg-forward
BB_PG_FORWARD_PORT=15432
# Absolute paths on this deployment host; dedicated key, not another machine's identity.
BB_PG_SSH_KEY_FILE=/etc/bondbuddy/pg-forward/key
BB_PG_SSH_KNOWN_HOSTS_FILE=/etc/bondbuddy/pg-forward/known_hosts
BB_BACKEND_SUBNET=10.232.0.0/24
BB_WEB_IP=10.232.0.10
# Preserve the existing domestic integrity route; do not silently replace it with direct egress.
BB_INTEGRITY_MODE=beijing
BB_INTEGRITY_BEIJING_HOST=verified-existing-integrity-host
BB_INTEGRITY_SSH_DIR=/etc/bondbuddy/integrity-ssh
BB_EGRESS_ALLOW=api.deepseek.com,replace-with-existing-allow-list

# Current split layout: parse runs only on main; both roles must use the same value.
BB_PARSE_ROLE=main
# Pin the clean deployment checkout independently from the real application image SHA.
# BB_DEPLOY_SCRIPT_SHA=<exact-40-character-script-commit>
# Preserve the audited private overlay automatically in all role lifecycle commands.
# Both entries are required together; hash is over the original file bytes.
# BB_ROLE_OVERRIDE_FILE=/etc/bondbuddy/role-override.yaml
# BB_ROLE_OVERRIDE_SHA256=<sha256-of-private-overlay>
