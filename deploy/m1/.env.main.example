# Merge into a protected copy of the current private env; retain all business/payment/Blob values.
BB_DEPLOY_ROLE=main
COMPOSE_PROJECT_NAME=bb-main
POSTGRES_PASSWORD=replace-with-existing-database-password
BB_MAIN_DATABASE_URL=postgresql://bondbuddy:replace-url-encoded-password@postgres:5432/bondbuddy
BB_PG_FORWARD_PORT=15432
BB_HTTP_PORT=18080
BB_BIND_ADDR=127.0.0.1
BB_BACKEND_SUBNET=10.231.0.0/24
BB_WEB_IP=10.231.0.10
BB_PUBLIC_ORIGIN=https://bondbuddy.example
BB_TERMS_VERSION=existing-terms-version
BB_TRIAL_SOURCE_SALT=replace-with-existing-value
BB_PARSE_CACHE_OCR_VERSION=existing-ocr-version
BB_PARSE_CACHE_BASIS_VERSION=existing-basis-version
AZURE_STORAGE_CONNECTION_STRING=replace-with-existing-private-blob-connection
BB_EGRESS_ALLOW=replace-with-existing-allow-list
BB_PAYMENT_SECRETS_DIR=/etc/bondbuddy/payments
BB_FILE_TEMPLATE_HOST_DIR=/opt/bondbuddy/private-file-templates/immutable-version
