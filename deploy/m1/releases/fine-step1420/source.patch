+++ b/apps/api/src/performance-dispatch.ts
@@ -0,0 +1,16 @@
+import type {Pool} from 'pg';
+import {recordPerformanceObservations,type PerformanceTraceScope} from './performance-trace.js';
+export type CommittedPerformanceDispatch={scope:PerformanceTraceScope;batchCreatedAt:string|Date;operation:string};
+/** Call only after transaction() has resolved: rolled-back admissions and idle polling emit nothing. */
+export function recordCommittedPerformanceDispatch(pool:Pool,admitted:CommittedPerformanceDispatch|null,startedAt:Date,endedAt:Date):void {
+ if(!admitted)return;
+ try{
+  const attributes={stage:'dispatch',operation:admitted.operation};
+  recordPerformanceObservations(pool,{...admitted.scope,serviceRole:'batch_dispatcher'},[
+   {stepKey:'batch.dispatch_transaction',interval:{startedAt,endedAt,clockSource:'wall_clock_observation'},
+    attributes:{...attributes,measurement_source:'transaction_call_through_commit'}},
+   {stepKey:'batch.item_wait',interval:{startedAt:admitted.batchCreatedAt,endedAt,clockSource:'wall_clock_observation'},
+    attributes:{...attributes,measurement_source:'batch_created_to_admission',wait_reason:'total_elapsed_including_pauses'}}
+  ]);
+ }catch{}
+}
diff --git a/apps/api/src/performance-lifecycle.ts b/apps/api/src/performance-lifecycle.ts
new file mode 100644
index 00000000..25292371
--- /dev/null
+++ b/apps/api/src/performance-lifecycle.ts
@@ -0,0 +1,36 @@
+import type {Pool} from 'pg';
+import {transaction} from './data.js';
+import type {LogRetentionPolicy} from './log-ops.js';
+/** Span details expire; immutable session counters and an explicit purge receipt remain. */
+export async function purgePerformanceSpans(pool:Pool,policy:LogRetentionPolicy):Promise<{sessions:number;spans:number}> {
+ const now=policy.now?.()??new Date(),days=policy.contentRetentionDays,deletedDays=policy.deletedProjectPurgeDays,batch=policy.batchSize??100;
+ const version=policy.policyVersion??'log_retention_v1';
+ if(!Number.isInteger(days)||days<1||!Number.isInteger(batch)||batch<1||batch>10000||!Number.isFinite(now.getTime())||
+   deletedDays!==undefined&&(!Number.isInteger(deletedDays)||deletedDays<0)||!/^[A-Za-z0-9_.:-]{1,128}$/.test(version))throw new Error('Invalid performance retention policy');
+ const cutoff=new Date(now.getTime()-days*86400000),deletedCutoff=deletedDays===undefined?null:new Date(now.getTime()-deletedDays*86400000);
+ return transaction(pool,async c=>{
+  // Serialize with the existing legal-hold set/release operations.
+  await c.query('SELECT pg_advisory_xact_lock(79,69)');
+  const rows=(await c.query(`SELECT s.session_id,
+   CASE WHEN u.status='closed' OR p.deleted_at<$4 OR scope_project.deleted_at<$4 THEN 'user_deleted' ELSE 'retention_expired' END reason
+   FROM bb_performance_sessions s JOIN bb_runs r ON r.owner_user_id=s.owner_user_id AND r.id=s.run_id
+   JOIN bb_projects p ON p.owner_user_id=s.owner_user_id AND p.id=s.project_id
+   JOIN bb_projects scope_project ON scope_project.owner_user_id=p.owner_user_id AND scope_project.id=coalesce(p.execution_scope_project_id,p.id)
+   JOIN bb_users u ON u.id=s.owner_user_id
+   WHERE s.purged_at IS NULL AND r.state IN ('succeeded','test_completed','failed','cancelled','rejected')
+   AND (s.started_at<$1 OR u.status='closed' OR p.deleted_at<$4 OR scope_project.deleted_at<$4)
+   AND ($3::text[] IS NULL OR s.owner_user_id=ANY($3))
+   AND NOT EXISTS(SELECT 1 FROM bb_log_archive_legal_holds h WHERE h.released_at IS NULL AND h.segment_id IS NULL
+    AND (h.user_id IS NULL OR h.user_id=s.owner_user_id)
+    AND (h.from_at IS NULL OR h.from_at<=greatest(s.ended_at,s.last_flush_at,s.started_at,(SELECT max(p.ended_at) FROM bb_performance_spans p WHERE p.session_id=s.session_id)))
+    AND (h.to_at IS NULL OR h.to_at>=least(s.started_at,(SELECT min(p.started_at) FROM bb_performance_spans p WHERE p.session_id=s.session_id))))
+   ORDER BY s.started_at,s.session_id LIMIT $2 FOR UPDATE OF s SKIP LOCKED`,[cutoff,batch,policy.ownerScope??null,deletedCutoff])).rows;
+  let spans=0;
+  for(const row of rows){
+   const deleted=await c.query('DELETE FROM bb_performance_spans WHERE session_id=$1',[row.session_id]),count=deleted.rowCount??0;
+   await c.query('UPDATE bb_performance_sessions SET purged_at=$2,purged_span_count=$3,purge_reason=$4,purge_policy_version=$5,complete=false WHERE session_id=$1',[row.session_id,now,count,row.reason,version]);
+   spans+=count;
+  }
+  return {sessions:rows.length,spans};
+ });
+}
diff --git a/apps/api/src/performance-routes.ts b/apps/api/src/performance-routes.ts
new file mode 100644
index 00000000..c3b0ba90
--- /dev/null
+++ b/apps/api/src/performance-routes.ts
@@ -0,0 +1,28 @@
+import type {FastifyInstance,FastifyRequest} from 'fastify';
+import type {Pool} from 'pg';
+import {schemas} from '@bondbuddy/contracts';
+import {missing,Problem} from './data.js';
+import {audit,operatorRoles} from './log-ops.js';
+import {parsePerformanceFilters,parsePerformancePage,readPerformanceRun,readPerformanceSummary} from './performance-data.js';
+export function installPerformanceRoutes(app:FastifyInstance,deps:{db:()=>Pool;owner:(request:FastifyRequest)=>Promise<string>}){
+ let active=0;
+ async function read(request:FastifyRequest,reply:any,kind:'run'|'summary'){
+  const actor=await deps.owner(request),pool=deps.db();
+  if(!(await operatorRoles(pool,actor)).has('log_reader'))throw missing();
+  const runId=kind==='run'?(request.params as {run_id:string}).run_id:null;
+  const parsed=runId?parsePerformancePage(runId,request.query):parsePerformanceFilters(request.query);
+  reply.header('cache-control','private, no-store');
+  if(active>=2){reply.header('retry-after','2');throw new Problem(503,'ADMIN_INSPECTION_BUSY','Performance queries are busy');}
+  active++;let c;
+  try{
+   c=await pool.connect();
+   const auditId=await audit(c,{actorId:actor,role:'log_reader',purpose:runId?'performance_run_read':'performance_summary_read',filter:parsed,target:runId??undefined});
+   await c.query('BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY');
+   await c.query("SET LOCAL statement_timeout='10s'");await c.query("SET LOCAL lock_timeout='500ms'");
+   const result=runId?await readPerformanceRun(c,runId,parsed as ReturnType<typeof parsePerformancePage>,auditId):await readPerformanceSummary(c,parsed as ReturnType<typeof parsePerformanceFilters>,auditId);
+   await c.query('COMMIT');return result;
+  }finally{if(c){await c.query('ROLLBACK').catch(()=>{});c.release();}active--;}
+ }
+ app.get('/api/v1/admin/performance/runs/:run_id',{schema:{response:{200:schemas.AdminPerformanceRunResponse}}},(r,p)=>read(r,p,'run'));
+ app.get('/api/v1/admin/performance/summary',{schema:{response:{200:schemas.AdminPerformanceSummaryResponse}}},(r,p)=>read(r,p,'summary'));
+}
diff --git a/apps/api/src/performance-store.ts b/apps/api/src/performance-store.ts
new file mode 100644
index 00000000..86e5a8e2
--- /dev/null
+++ b/apps/api/src/performance-store.ts
@@ -0,0 +1,60 @@
+import {Pool,type PoolClient} from 'pg';
+import type {PerformanceBatchWriter,PerformanceSessionRecord,PerformanceSpanRecord} from './performance-trace.js';
+const sessionRecord=`session_id text,owner_user_id text,project_id text,run_id text,job_id text,trace_id text,run_execution_id text,task_kind text,service_role text,worker_instance_id text,release_sha text,started_at timestamptz,ended_at timestamptz,last_flush_at timestamptz,closed boolean,generated integer,acknowledged integer,dropped integer,invalid_attributes integer,flush_errors integer,last_sequence integer,complete boolean`;
+const spanRecord=`span_id text,owner_user_id text,run_id text,session_id text,run_execution_id text,trace_id text,job_id text,parent_span_id text,stage text,step_key text,step_version integer,status text,started_at timestamptz,ended_at timestamptz,duration_ms double precision,last_activity_at timestamptz,clock_source text,attributes jsonb,span_links jsonb,sequence integer`;
+/** Separate pool and transaction: telemetry never holds the caller's run/lease/billing transaction. */
+export function createPerformanceBatchWriter(source:Pool):PerformanceBatchWriter{
+ const pool=new Pool({...source.options,max:1,min:0,allowExitOnIdle:true,connectionTimeoutMillis:500,idleTimeoutMillis:3000,
+  statement_timeout:1000,query_timeout:1500,lock_timeout:250,application_name:'bondbuddy-performance'});
+ // Idle connection failures are advisory too; pg otherwise emits an unhandled error.
