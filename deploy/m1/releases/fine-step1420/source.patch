+export const PERFORMANCE_ATTRIBUTE_COUNTS=['attempt_no','item_attempt','repair_round','batch_index','material_index','item_index','bytes','byte_size','bytes_expected','bytes_read','bytes_written','input_bytes','output_bytes','page_count','file_count','table_count','image_count','item_count','input_tokens','output_tokens','cached_input_tokens','reasoning_tokens','tool_count','tool_attempts','tool_missing_start_count','tool_missing_end_count','tool_omitted_count','poll_count','retry_count','max_parallel','exit_code','first_stdout_ms','first_event_ms','first_agent_message_observed_ms','tool_busy_union_ms','tool_duration_sum_ms','idle_since_last_event_ms','read_count','write_count','duration_ms','elapsed_ms'] as const;
+export const PERFORMANCE_ATTRIBUTE_FLAGS=['cache_hit','reused','schema_reask','snapshot_reused','timing_complete','end_missing','tool_timing_complete','owns_worker_slot','cancel_requested'] as const;
+export const PerformanceAttributesSchema=obj({
+ ...fields(PERFORMANCE_ATTRIBUTE_CODES,Type.Optional(code)),
+ ...fields(PERFORMANCE_ATTRIBUTE_COUNTS,Type.Optional(nullable(ms))),
