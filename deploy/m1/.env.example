# Copy to deploy/m1/.env (untracked, chmod 600) and fill in on the target host. Names only here.
COMPOSE_PROJECT_NAME=
# Set to staging-blob to run Azurite (staging only); leave empty in production.
COMPOSE_PROFILES=
POSTGRES_PASSWORD=
# Azurite in staging; private Azure Blob account connection string in production.
AZURE_STORAGE_CONNECTION_STRING=
# Required parse-cache invalidation identities. Start with these code-aligned values;
# bump OCR on processor/engine/language-data changes and basis on evidence-basis logic changes.
BB_PARSE_CACHE_OCR_VERSION=bondbuddy-ocr-1.0.0
BB_PARSE_CACHE_BASIS_VERSION=evidence-basis-v1
# Exact browser origin, e.g. https://bondbuddy.example.com
BB_PUBLIC_ORIGIN=
BB_TERMS_VERSION=
BB_SUPPORT_CONTACT=
BB_BIND_ADDR=
BB_HTTP_PORT=
# Worker egress allow-list (production adds the Blob host, e.g. <account>.blob.core.windows.net)
BB_EGRESS_ALLOW=
BB_CODEX_CREDENTIAL_ENV=
DEEPSEEK_API_KEY=
BB_CODEX_BASE_URL=
BB_CODEX_MODEL=
# small-host production profile: prod
BB_PROFILE=
# Internal network; pick a free /24 if the default overlaps another Docker network
BB_BACKEND_SUBNET=
BB_WEB_IP=
# Trial guard: random per environment (e.g. openssl rand -hex 24); keep only on the target host
BB_TRIAL_SOURCE_SALT=
BB_TRIAL_GUARD=on
BB_TRIAL_KILL_SWITCH=
# Data lifecycle overrides (defaults = published M1 trial policy: purge deleted material after 7 days,
# orphan grace 24 h, log content 180 days, backups 30 days)
BB_STORAGE_PURGE_ENABLED=
BB_STORAGE_MATERIAL_RETENTION_DAYS=
BB_STORAGE_ORPHAN_GRACE_HOURS=
BB_LOG_CONTENT_RETENTION_DAYS=
BB_BACKUP_RETENTION_DAYS=
# #35 off-host backups: backup.sh uploads to the private bb-backups container (off = keep local only, dev stacks)
BB_BACKUP_OFFHOST=
# Upload spool (disk volume uploadspool): max in-flight spooled bytes; default 1 GiB, prod profile 500 MiB
BB_UPLOAD_SPOOL_MAX_BYTES=
