# Copy to deploy/m1/.env (untracked, chmod 600) and fill in on the target host. Names only here.
COMPOSE_PROJECT_NAME=
# Set to staging-blob to run Azurite (staging only); leave empty in production.
COMPOSE_PROFILES=
# Explicit runtime tier. The internal test channel requires preprod and an enabled switch.
BB_DEPLOYMENT_TIER=production
BB_NON_PRODUCTION_TEST_CHANNEL=disabled
# Current task scope pricing is mandatory; historical policy flags cannot disable it.
# Real checkout remains controlled by the separate merchant settings below.
BB_PAID_AUTHORING_ENABLED=1
# Preproduction working drafts only: keep all five empty unless a time-limited test is approved.
# EXPIRES_AT is a future ISO timestamp within seven days; hashes are exact 64-character lowercase
# SHA-256 pins for the candidate taxonomy and rule pack; STAGE is registration or issuance;
# AS_OF is the rule evaluation date (YYYY-MM-DD). Partial configuration fails closed.
BB_PREPROD_WORKING_DRAFT_EXPIRES_AT=
BB_PREPROD_WORKING_DRAFT_TAXONOMY_HASH=
BB_PREPROD_WORKING_DRAFT_RULE_PACK_HASH=
BB_PREPROD_WORKING_DRAFT_STAGE=
BB_PREPROD_WORKING_DRAFT_AS_OF=
# Temporary preproduction upload exception; disabled by default. Scope format:
# owner_user_id:project_id:audit:byte_size:sha256. Remove both values after verification.
BB_UPLOAD_EXCEPTION_ENABLED=0
BB_UPLOAD_EXCEPTION_SCOPE=
POSTGRES_PASSWORD=
# Azurite in staging; private Azure Blob account connection string in production.
AZURE_STORAGE_CONNECTION_STRING=
# Required parse-cache invalidation identities. Start with these code-aligned values;
# bump OCR on processor/engine/language-data changes and basis on evidence-basis logic changes.
BB_PARSE_CACHE_OCR_VERSION=bondbuddy-ocr-1.0.1
BB_PARSE_CACHE_BASIS_VERSION=evidence-basis-v1
# Separate authoring/review/parsing containers; production reserves one slot each.
BB_WORKER_CONCURRENCY=1
# Reserved capacity for ordinary QA, question recognition/answers and file checks.
# 0 disables the additional slot. Does not increase long-document capacity.
BB_WORKER_INTERACTIVE_SLOTS=1
BB_REVIEW_WORKER_CONCURRENCY=1
# Execution-role review limits only. Capacity changes require isolated complete-run evidence.
# The memory limit includes Node, model CLI, Python, buffers and /tmp; heap is only Node old space.
BB_REVIEW_NODE_HEAP_MIB=768
BB_REVIEW_CPU_LIMIT=0.75
BB_REVIEW_MEMORY_LIMIT=2G
BB_PARSE_WORKER_CONCURRENCY=1
BB_WORKER_DRAIN_MS=20000
# #15/#31 fact evidence review guard (off by default). Set 1 only when real fact_evidence_reviewer
# decisions exist for the run's exact pins; unreviewed/withdrawn/drifted facts are then excluded.
BB_FACT_EVIDENCE_REVIEW_GATE=0
# #76 target-period candidate producer call in the worker run pipeline (off by default). Set 1 only
# when the locked input's financial materials and the current draft may persist a pending candidate.
BB_TARGET_PERIOD_CANDIDATE_PRODUCER=0
# Exact browser origin, e.g. https://bondbuddy.example.com
BB_PUBLIC_ORIGIN=
BB_TERMS_VERSION=
BB_SUPPORT_CONTACT=
BB_BIND_ADDR=
BB_HTTP_PORT=
# API/worker egress allow-list (production adds the Blob host, e.g. <account>.blob.core.windows.net)
# When BB_OPS_LIBRARY_SYNC=on, append query.sse.com.cn and static.sse.com.cn
# to the existing DeepSeek and Blob hosts; keep the sync switch off until rehearsed.
# When enabling WeChat Native, append only api.mch.weixin.qq.com to the existing hosts.
# Example: api.deepseek.com,<account>.blob.core.windows.net,api.mch.weixin.qq.com
# Do not add wildcard/suffix domains or proxy bypasses; no merchant host is added by default.
BB_EGRESS_ALLOW=
# Keep bypasses limited to internal service/loopback addresses. API and ops read both cases.
BB_NO_PROXY=postgres,azurite,api,localhost,127.0.0.1
BB_CODEX_CREDENTIAL_ENV=
DEEPSEEK_API_KEY=
# Copilot switch: set all values together on the target host; leave AUTH_MODE empty for rollback.
# OAuth file must be a private regular file readable by container UID 1000. Never put its contents here.
BB_CODEX_AUTH_MODE=
BB_COPILOT_OAUTH_HOST_FILE=
BB_CODEX_PROVIDER=
BB_CODEX_REASONING_EFFORT=
BB_CODEX_CONFIG_VERSION=
BB_OPS_PROVIDER_BALANCE=on
BB_OPS_PROVIDER_BALANCE_SECONDS=300
BB_PROVIDER_BALANCE_THRESHOLD_USD=1
BB_CODEX_BASE_URL=
BB_CODEX_MODEL=
# Per model call wall-clock limit in ms (compose default 600000)
BB_CODEX_TIMEOUT_MS=
# Document authoring wall-clock limit in ms (5 h / 18000000 default, not a completion ETA).
# Separate from short probes; explicit cancellation and lease loss still stop work.
BB_CODEX_AUTHORING_TIMEOUT_MS=
# M3 public review is off by default; disabled search is reported as uncovered, not passed.
# Set 1 only after verifying real web_search support and required egress for the configured
# provider. Recreate the worker after changing this value; this does not change its provider.
BB_REVIEW_WEB_SEARCH_ENABLED=0
# small-host production profile: prod
BB_PROFILE=
# Internal network; pick a free /24 if the default overlaps another Docker network
BB_BACKEND_SUBNET=
BB_WEB_IP=
# Trial guard: random per environment (e.g. openssl rand -hex 24); keep only on the target host
BB_TRIAL_SOURCE_SALT=
BB_TRIAL_GUARD=on
# Daily run/token/project/upload-byte limits are retired; legacy *_PER_USER_PER_DAY values are ignored.
BB_TRIAL_KILL_SWITCH=
# Data lifecycle overrides (defaults = published M1 trial policy: purge deleted material after 7 days,
# orphan grace 24 h, log content 180 days, backups 30 days)
BB_STORAGE_PURGE_ENABLED=
BB_STORAGE_MATERIAL_RETENTION_DAYS=
BB_STORAGE_ORPHAN_GRACE_HOURS=
BB_LOG_CONTENT_RETENTION_DAYS=
BB_LOG_ARCHIVE_ENABLED=0
BB_LOG_ARCHIVE_RETENTION_DAYS=180
BB_BACKUP_RETENTION_DAYS=
# #35 off-host backups: backup.sh uploads to the private bb-backups container (off = keep local only, dev stacks)
BB_BACKUP_OFFHOST=
# Comma-separated application Blob containers to export. Include every container used by API,
# log archive and reference library if configured separately; the off-host container is excluded.
BB_BLOB_BACKUP_CONTAINERS=
BB_BACKUP_CONTAINER=bb-backups
BB_LOG_ARCHIVE_CONTAINER=bondbuddy-private
BB_LIBRARY_CONTAINER=bondbuddy-private
# Upload spool (disk volume uploadspool): max in-flight spooled bytes; default 1 GiB, prod profile 500 MiB
BB_UPLOAD_SPOOL_MAX_BYTES=
# New HTTP tasks always use automatic scope pricing. These historical policy flags
# cannot re-enable fixed/manual quotation issuance. Deploy the image and migrations together.
BB_OUTCOME_PRICING_ENABLED=1
# Subscription plus top-up task pricing is the current policy for API and workers.
# Native checkout supports a single subscription period; it is not an automatic-renewal mandate.
# Setting this flag alone supplies neither merchant credentials nor payment acceptance evidence.
BB_SUBSCRIPTION_BILLING_ENABLED=1
BB_WECHAT_PAY_ENABLED=0
BB_WECHAT_PAY_MERCHANT_ID=
BB_WECHAT_PAY_APP_ID=
BB_WECHAT_PAY_MERCHANT_CERT_SERIAL=
BB_WECHAT_PAY_NOTIFY_URL=
BB_WECHAT_PAY_REFUND_ENABLED=0
BB_WECHAT_PAY_REFUND_NOTIFY_URL=
BB_WECHAT_PAY_TIMEOUT_MS=10000
# Read-only daily statement reconciliation; requires signed merchant configuration.
# The default is off. Enabling downloads only the previous 7 days after 10:00 Asia/Shanghai.
# Existing unresolved jobs retry with backoff. Statements never issue credits or settle refunds.
BB_WECHAT_PAY_STATEMENTS_ENABLED=0
# Exact merchant fund accounts; add OPERATION,FEES only when those accounts are in use.
BB_WECHAT_PAY_STATEMENT_ACCOUNTS=BASIC
# Host directory mounts read-only to /run/bondbuddy-payments in the API container.
# Secret files must be readable by the API runtime uid (the image uses node/1000), with mode 0600.
# A root-owned 0600 file is not readable by this container user.
# Use absolute container paths; set these only after supplying actual merchant files.
BB_PAYMENT_SECRETS_DIR=./secrets/payments
BB_WECHAT_PAY_PRIVATE_KEY_FILE=
BB_WECHAT_PAY_API_V3_KEY_FILE=
BB_WECHAT_PAY_PLATFORM_KEYS_FILE=

# Optional Alipay direct-merchant RSA2 public-key mode. Default off.
# AI Web App Payment uses page for both PC and mobile browsers/H5.
# wap is retained only for an existing, separately contracted legacy product.
# Neither product authorizes recurring payment. No mandate or automatic top-up is enabled.
# Add exactly openapi.alipay.com to BB_EGRESS_ALLOW when this channel is enabled.
BB_ALIPAY_PAY_ENABLED=0
BB_ALIPAY_ENVIRONMENT=production
BB_ALIPAY_APP_ID=
BB_ALIPAY_SELLER_ID=
BB_ALIPAY_WEB_PRODUCT=
# Protected absolute paths inside the container, mounted read-only like the WeChat files.
BB_ALIPAY_APP_PRIVATE_KEY_FILE=
# Raw Base64 keys: PKCS1 or PKCS8, matching the actual key supplied by the owner.
# Leave empty for existing PEM files. Never paste key contents into this example.
BB_ALIPAY_APP_PRIVATE_KEY_TYPE=
BB_ALIPAY_PUBLIC_KEY_FILE=
# Exact payment callback path: https://<public-host>/api/v1/payments/alipay/callback
BB_ALIPAY_NOTIFY_URL=
# Exact HTTPS result page: https://<public-host>/payment/alipay/return.html
# A return redirect never credits the wallet.
BB_ALIPAY_RETURN_URL=
# Enable only after verifying original buyer_pay_amount and per-request
# present_refund_buyer_amount availability for this merchant. Missing evidence keeps refunds unresolved.
BB_ALIPAY_REFUND_ENABLED=0
BB_ALIPAY_PAY_TIMEOUT_MS=10000
# Read-only daily statement reconciliation. Requires BB_ALIPAY_PAY_ENABLED=1.
# In addition to openapi.alipay.com, append exactly dwbillcenter.alipay.com to
# BB_EGRESS_ALLOW before enabling. Do not add a wildcard or a NO_PROXY bypass.
# Defaults off; after 10:00 Asia/Shanghai schedules the previous 7 days.
# Unresolved jobs retry with backoff; statements never credit wallets or settle refunds.
# Current Alipay CSV format is unverified; downloaded statements remain unknown.
# Keep disabled until the statement format and merchant acceptance are verified.
BB_ALIPAY_PAY_STATEMENTS_ENABLED=0

# Opt-in only after the private Blob CORS and exact-origin CSP allow browser PUT.
BB_DIRECT_BLOB_UPLOADS=0

# Explicit execution capacity. Four document slots include QA/file work; do not
# leave an additional interactive slot enabled when setting authoring to four.
# BB_AUTHORING_WORKER_CONCURRENCY=1
# BB_AUTHORING_INTERACTIVE_SLOTS=1
# BB_AUTHORING_NODE_HEAP_MIB=768
# BB_AUTHORING_CPU_LIMIT=0.75
# BB_AUTHORING_MEMORY_LIMIT=2G
# All authoring/review/assistant calls share this global cap in the sole database.
# Install the capacity migration and matching adapters on both execution services.
BB_MODEL_CALL_CONCURRENCY=4
BB_REVIEW_ASSISTANT_SLOTS=1

# SHA-256 of the execution host machine-id; shared by its model containers.
# BB_MODEL_EXECUTION_HOST_ID=
