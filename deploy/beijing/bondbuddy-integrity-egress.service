[Unit]
Description=BondBuddy official website egress
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/node /opt/bondbuddy-egress/current/proxy.mjs
Environment=NODE_ENV=production
Environment=BB_INTEGRITY_EGRESS_BIND_HOST=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
MemoryMax=128M
CPUQuota=25%
TasksMax=32

[Install]
WantedBy=multi-user.target
