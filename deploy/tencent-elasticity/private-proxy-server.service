[Unit]
Description=Authenticated execution pool egress
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/stunnel /var/lib/bondbuddy/elastic-pg-mtls/proxy/server.conf
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=64M
CPUQuota=25%
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
