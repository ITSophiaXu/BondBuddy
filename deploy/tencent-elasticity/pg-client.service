[Unit]
Description=Private authenticated database transport
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=1000
RuntimeDirectory=bondbuddy/transport-socket
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/node /opt/bondbuddy/deploy/tencent-elasticity/transport-service.mjs
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/etc/bondbuddy/transport /run/bondbuddy/transport-socket
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=null
StandardError=journal

# Intentionally static: only the bounded bootstrap starts this transport after
# installing the current epoch's certificate. Never enable it at machine boot.
