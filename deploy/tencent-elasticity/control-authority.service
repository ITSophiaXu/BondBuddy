[Unit]
Description=Local execution signing and temporary control credentials
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bondbuddy-elastic-control
ExecStart=/usr/bin/node /opt/bondbuddy-elastic-control/deploy/tencent-elasticity/control-authority.mjs
User=root
Group=1000
RuntimeDirectory=bondbuddy/elastic-control
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/bondbuddy/elastic-pg-mtls /run/bondbuddy/elastic-control
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CPUQuota=25%
StandardOutput=null
StandardError=journal
