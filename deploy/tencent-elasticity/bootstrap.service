[Unit]
Description=Initialize the execution pool node
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
UMask=0077
Environment=NODE_USE_ENV_PROXY=1
Environment=HTTPS_PROXY=http://10.2.0.5:3128
Environment=HTTP_PROXY=http://10.2.0.5:3128
Environment=NO_PROXY=localhost,127.0.0.1,169.254.0.23,metadata.tencentyun.com,172.28.61.1,10.2.0.5
# The image leaves this unit disabled. The installed, hashed adapter and a
# validated public slot binding establish persistent boot activation.
ExecStart=/usr/bin/node /opt/bondbuddy/deploy/tencent-elasticity/bootstrap-entry.mjs
# One persisted admission cooldown (<=60s), bounded enrollment (<=180s),
# then artifact and readiness checks. This does not restart a failed entry.
TimeoutStartSec=600
RemainAfterExit=yes
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
