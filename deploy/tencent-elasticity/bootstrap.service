[Unit]
Description=Initialize the execution pool node
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
UMask=0077
Environment=NODE_USE_ENV_PROXY=1
Environment=HTTPS_PROXY=http://10.2.0.5:3128
Environment=HTTP_PROXY=http://10.2.0.5:3128
Environment=NO_PROXY=localhost,127.0.0.1,169.254.0.23,metadata.tencentyun.com,172.28.61.1,10.2.0.5
# The entrypoint is installed and hashed in the reviewed image. Role enrollment
# and the runtime adapter must be provisioned before enabling this unit.
ExecStart=/usr/bin/node /opt/bondbuddy/deploy/tencent-elasticity/bootstrap-entry.mjs
TimeoutStartSec=300
RemainAfterExit=yes
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
