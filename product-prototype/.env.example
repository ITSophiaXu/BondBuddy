PORT=4320
# Local checkout UX only. No live merchant integration. Use disabled to block orders.
BILLING_MODE=sandbox
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional: official compatible endpoint; the key stays on the server.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# BOND_BUDDY_CODEX=C:/path/to/codex.exe
# BOND_BUDDY_PYTHON=C:/path/to/python.exe
# Optional search provider (Tavily), and a company registry connector.
TAVILY_API_KEY=
# Registry adapter: POST {"query":"company name"}, bearer authentication,
# response {"results":[{"title":"...","url":"https://...","content":"..."}]}
REGISTRY_URL=
REGISTRY_API_KEY=

# Platform operators only. Leave empty to disable configuration APIs.
# Customers never configure service keys or send this token.
BOND_BUDDY_ADMIN_TOKEN=
