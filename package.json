{
  "name": "bondbuddy-m1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contracts",
    "packages/domain",
    "packages/rule-pack-registry",
    "packages/rule-applicability-context",
    "apps/api",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "test:release": "node scripts/release-smoke/run.mjs",
    "test:release:unit": "node --test scripts/release-smoke/support.test.mjs scripts/release-smoke/qa-prospectus.test.mjs scripts/release-smoke/qa-preparation.test.mjs",
    "billing:mock": "node scripts/billing-functional/start.mjs",
    "billing:mock:stop": "node scripts/billing-functional/stop.mjs",
    "test:billing:mock": "node --test scripts/billing-functional/payment-provider.test.mjs scripts/billing-functional/billing-client.test.mjs",
    "test:billing:mock:flow": "node scripts/billing-functional/payment-lifecycle-verify.mjs",
    "test:billing:mock:edges": "node scripts/billing-functional/payment-edge-verify.mjs && node scripts/billing-functional/subscription-dispatch-recovery-verify.mjs && node scripts/billing-functional/cashier-edge-browser-verify.mjs && node scripts/billing-functional/subscription-two-tab-verify.mjs",
    "test:billing:mock:restart": "node scripts/billing-functional/payment-restart-verify.mjs",
    "test:billing:mock:compatibility": "node scripts/billing-functional/billing-policy-conflict-verify.mjs && node scripts/billing-functional/billing-policy-compatibility-verify.mjs && node scripts/billing-functional/m4-billing-policy-compatibility-verify.mjs",
    "build": "npm run build -w @bondbuddy/contracts && npm run build -w @bondbuddy/domain && npm run build -w @bondbuddy/rule-pack-registry && npm run build -w @bondbuddy/rule-applicability-context && npm run build -w @bondbuddy/api && npm run build -w @bondbuddy/worker && npm run build -w @bondbuddy/web",
    "dev:web": "npm run dev -w @bondbuddy/web",
    "test:web": "npm test -w @bondbuddy/web",
    "check:contracts": "npm run check:examples -w @bondbuddy/contracts",
    "test:api": "npm test -w @bondbuddy/api",
    "test:domain": "npm test -w @bondbuddy/domain",
    "test:documents": "PYTHONPATH=python python3 -m unittest discover -s python/tests -v",
    "quality:prospectus": "node scripts/prospectus-quality-gate.mjs run",
    "quality:prospectus:validate": "node scripts/prospectus-quality-gate.mjs validate",
    "quality:prospectus:verify": "node scripts/prospectus-quality-gate.mjs verify",
    "quality:prospectus:publish-status": "node scripts/publish-prospectus-quality.mjs",
    "start:api": "npm start -w @bondbuddy/api",
    "migrate:api": "node db/migrate.mjs",
    "storage:lifecycle": "npm run build -w @bondbuddy/contracts && npm run build -w @bondbuddy/api && npm run storage:lifecycle -w @bondbuddy/api",
    "ocr:preflight": "node apps/worker/dist/ocr.js",
    "ocr:v2": "node apps/worker/dist/ocr-v2.js"
  }
}
